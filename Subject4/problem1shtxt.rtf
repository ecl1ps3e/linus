\f1\b\fs26 \cf2 \cb3 #!/bin/bash\
\

\f2\b0 \cf4 # Check if we have at least a word and one file\
\cf5 if \cf2 [ \cf6 "\cf2 $#\cf6 " \cf2 -lt \cf7 2 \cf2 ]; \cf5 then\
    \cf8 echo \cf6 "Usage: \cf2 $0\cf6  <word> <file1> <file2> ..."\
    \cf8 exit \cf7 1\
\cf5 fi\
\
\cf4 # The first argument is the word to search for\
\cf2 word=$1\
\
\cf4 # Shift moves all arguments one position to the left (so $2 becomes $1)\
# This lets us easily loop over the files\
\cf8 shift\
\
\cf5 for \cf2 f \cf5 in \cf6 "\cf2 $@\cf6 "\cf2 ; \cf5 do\
    if \cf2 [ -f \cf6 "\cf2 $f\cf6 " \cf2 ]; \cf5 then\
        \cf4 # 1. Count how many times the word appears\
        # -o prints each match on a new line, allowing wc -l to count them accurately\
        \cf2 count=\cf5 $\cf8 (grep \cf2 -E -o \cf6 "\\b\cf2 $word\cf6 \\b" "\cf2 $f\cf6 " \cf2 | \cf8 wc \cf2 -l\cf8 )\
\
        \cf4 # 2. Replace the word with XXX\
        # We output to a temporary file, then overwrite the original.\
        # This safely avoids the differences between Mac and Linux 'sed -i' commands!\
        \cf8 sed \cf2 -E \cf6 "s/\\b\cf2 $word\cf6 \\b/XXX/g" "\cf2 $f\cf6 " \cf5 > \cf2 temp.txt\
        \cf8 mv \cf2 temp.txt \cf6 "\cf2 $f\cf6 "\
\
        \cf4 # 3. Print the result\
        \cf8 echo \cf6 "File: \cf2 $f\cf6  - Replacements made: \cf2 $count\cf6 "\
    \cf5 else\
        \cf8 echo \cf6 "Warning: File '\cf2 $f\cf6 ' does not exist."\
    \cf5 fi\
done\
}